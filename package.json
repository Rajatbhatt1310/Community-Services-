{
  "name": "cybersafe-school",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "CyberSafe School: cybersecurity awareness learning platform for Classes 9 to 12.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite",
    "dev:server": "node --watch server/index.js",
    "build": "vite build",
    "start": "node server/index.js",
    "check:content": "node scripts/check-content.mjs",
    "test:functions": "node --disable-warning=ExperimentalWarning scripts/test-functions.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^4.22.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^6.4.5"
  },
  "overrides": {
    "rollup": "npm:@rollup/wasm-node@^4.67.2"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
